# ==============================================================================
# GrocerAI â€” Environment Variables Specification
# ==============================================================================
# Copy this file to .env for local development.
# In Vercel, configure these variables in: Project Settings -> Environment Variables.
# NEVER commit your actual .env file or real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Database (Authoritative Business Store)
# ------------------------------------------------------------------------------
# Get your project credentials from: https://supabase.com/dashboard/project/_/settings/api
# SUPABASE_URL: Project URL (e.g., https://your-project.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_PUBLISHABLE_KEY / VITE_SUPABASE_ANON_KEY: Public Anon Key (safe for browser client)
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key_here

# Public absolute origin used by server-generated kiosk/mobile session QR URLs.
# Leave blank for localhost:3000. For a physical-device demo, set the reachable LAN origin.
# In Vercel, set the deployed HTTPS domain; previews can use VERCEL_URL when this is blank.
APP_BASE_URL=

# Optional server-only bootstrap credentials for /api/auth/manager.
# Both password and salt must be set; never use VITE_ prefixes for these.
MANAGER_BOOTSTRAP_ID=
MANAGER_BOOTSTRAP_USERNAME=
MANAGER_BOOTSTRAP_PASSWORD=
MANAGER_BOOTSTRAP_SALT=
MANAGER_BOOTSTRAP_NAME=
MANAGER_SESSION_SECRET=

# SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY: Privileged Server-Only Key
# CRITICAL SECURITY: NEVER expose this key to browser bundles or public variables!
SUPABASE_SECRET_KEY=your_supabase_secret_service_role_key_here

# ------------------------------------------------------------------------------
# 3. Groq LLM Reasoning Engine (Customer & Store Autonomous Agents)
# ------------------------------------------------------------------------------
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ------------------------------------------------------------------------------
# 4. Native memory uses the existing server-only Supabase URL and secret key.
# Review and apply supabase/migrations/20261021_native_grocerai_memory.sql manually.

# ------------------------------------------------------------------------------
# 5. Email Communication Gateway (Resend / SMTP)
# ------------------------------------------------------------------------------
# RESEND_API_KEY: Server-Only Secret API Key from https://resend.com/api-keys
# CRITICAL SECURITY: SERVER-ONLY! Never prefix with VITE_* or expose to browser.
RESEND_API_KEY=your_resend_api_key_here

# EMAIL_FROM: Verified sender address or Resend onboarding address
# In Resend onboarding mode, use 'GrocerAI <onboarding@resend.dev>'
EMAIL_FROM="GrocerAI <onboarding@resend.dev>"

# MANAGER_ALERT_EMAIL: Store Manager email for High/Critical security incident alerts
MANAGER_ALERT_EMAIL=manager@example.com
