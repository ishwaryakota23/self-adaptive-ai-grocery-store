# GrocerAI Backend Environment Configuration
# Add your Groq API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Hindsight Experiential Memory Configuration
# Use local daemon (default http://localhost:8888) or Hindsight Cloud (https://api.hindsight.vectorize.io)
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_API_LLM_PROVIDER=groq
HINDSIGHT_STORE_BANK=grocerai-store-main

