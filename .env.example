# ==============================================================================
# GrocerAI — Environment Variables Specification
# ==============================================================================
# Copy this file to .env for local development.
# In Vercel, configure these variables in: Project Settings -> Environment Variables.
# NEVER commit your actual .env file or real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq LLM Reasoning Engine (Required for Live Customer & Store Agents)
# ------------------------------------------------------------------------------
# Get your API key from: https://console.groq.com/keys
# Vercel Deployment: Configure as a private environment variable.
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (default: llama-3.3-70b-versatile; fallback supported: qwen/qwen3.8-27b)
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 2. Hindsight Experiential Memory & Learning Engine
# ------------------------------------------------------------------------------
# Local Development: Default is http://localhost:8888 (running via scripts/start-hindsight.py)
# Vercel Deployment: Configure to an externally accessible Hindsight deployment URL
# (e.g., https://your-hindsight-service.com or https://api.hindsight.vectorize.io).
# If unconfigured on Vercel, GrocerAI gracefully operates with memory features in offline mode.
HINDSIGHT_BASE_URL=http://localhost:8888

# Optional API key for authenticated Hindsight cloud or remote instances
HINDSIGHT_API_KEY=

# LLM provider used by Hindsight background daemon for memory consolidation
HINDSIGHT_API_LLM_PROVIDER=groq

# Store-wide operational memory bank identifier
HINDSIGHT_STORE_BANK=grocerai-store-main
